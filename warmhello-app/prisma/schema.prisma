generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCurrency {
  USD
  CAD
}

enum CheckInStatus {
  PENDING
  CONFIRMED
  REMINDER_SENT
  ESCALATED
  EXPIRED
}

enum AlertJobStatus {
  PENDING
  SENT
  FAILED
}

enum SmsDirection {
  OUT
  IN
}

enum SmsStatus {
  SENT
  FAILED
  RECEIVED
}

model Subscriber {
  id                   String             @id @default(cuid())
  email                String             @unique
  fullName             String
  phoneNumber          String
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  billingCurrency      BillingCurrency    @default(USD)
  currentPeriodEndsAt  DateTime?
  unsubscribedAt       DateTime?
  created              DateTime           @default(now()) @map("Created")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  seniors              Senior[]
  contacts             Contact[]
  checkIns             CheckIn[]
  smsLogs              SmsLog[]
}

model Senior {
  id           String     @id @default(cuid())
  subscriberId String
  firstName    String
  lastName     String
  phoneNumber  String
  timezone     String     @default("America/New_York")
  checkInHour  Int        @default(9)
  checkInMinute Int       @default(0)
  secondAttemptHours Int  @default(1)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  checkIns     CheckIn[]
  smsLogs      SmsLog[]
}

model Contact {
  id           String     @id @default(cuid())
  subscriberId String
  seniorId     String
  fullName     String
  relationship String
  phoneNumber  String
  priority     Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  senior       Senior     @relation(fields: [seniorId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id           String        @id @default(cuid())
  subscriberId String
  seniorId     String
  token        String        @unique
  status       CheckInStatus @default(PENDING)
  scheduledFor DateTime
  reminderAt   DateTime
  escalationAt DateTime
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  senior       Senior        @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  alertJobs    AlertJob[]
  smsLogs      SmsLog[]
  shortLink    ShortLink?
}

model AlertJob {
  id                String         @id @default(cuid())
  checkInId         String
  kind              String
  status            AlertJobStatus @default(PENDING)
  providerMessageId String?
  payload           Json
  runAt             DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  checkIn           CheckIn        @relation(fields: [checkInId], references: [id], onDelete: Cascade)
}

model SmsLog {
  id                String       @id @default(cuid())
  direction         SmsDirection
  status            SmsStatus
  provider          String       @default("telnyx")
  providerMessageId String?
  kind              String?
  fromNumber        String
  toNumber          String
  body              String
  subscriberId      String?
  seniorId          String?
  checkInId         String?
  createdAt         DateTime     @default(now())

  subscriber Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  senior     Senior?     @relation(fields: [seniorId], references: [id], onDelete: SetNull)
  checkIn    CheckIn?    @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([subscriberId, createdAt])
  @@index([seniorId, createdAt])
  @@index([checkInId, createdAt])
}

model ShortLink {
  id         String   @id @default(cuid())
  code       String   @unique
  targetPath String
  kind       String?
  checkInId  String?  @unique
  createdAt  DateTime @default(now())

  checkIn CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([checkInId])
}
